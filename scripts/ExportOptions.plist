<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Destino: App Store Connect, que es de donde sale TestFlight. -->
  <key>method</key>
  <string>app-store-connect</string>
  <key>destination</key>
  <string>export</string>
  <!-- Xcode pide y renueva los perfiles de distribución solo. -->
  <key>signingStyle</key>
  <string>automatic</string>
  <!-- Los símbolos van con el build: sin esto los crashes llegan ilegibles. -->
  <key>uploadSymbols</key>
  <true/>
  <key>manageAppVersionAndBuildNumber</key>
  <false/>
  <key>teamID</key>
  <string>VPNXQ8K2P8</string>
</dict>
</plist>
